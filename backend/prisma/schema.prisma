generator client {
  provider = "prisma-client-js"
}

enum UserStatus {
  ACTIVE
  INVITED
  SUSPENDED
  DEACTIVATED
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users      User[]
  roles      Role[]
  projects   Project[]
  auditLogs  AuditLog[]
  importJobs ImportJob[]

  // Phase 7 Organization extensions
  status               String    @default("ACTIVE")
  companyType          String?
  country              String?
  timezone             String?
  currency             String?
  address              String?
  contactInfo          Json?
  defaultProjectStatus String?
  financialSettings    Json?
  dateFormat           String?
  units                String?
  taxConfiguration     Json?
  plan                 String?
  subscriptionStatus   String?
  trialStartedAt       DateTime?
  trialEndsAt          DateTime?
  userLimit            Int?
  projectLimit         Int?
  storageLimit         Int?
  featureEntitlements  Json?

  // Phase 8 Tenant Branding extensions
  logoUrl         String?
  faviconUrl      String?
  subdomain       String? @unique
  customDomain    String? @unique
  primaryColor    String?
  secondaryColor  String?
  loginBackground String?

  // Phase 3 extensions
  contractors  Contractor[]
  workers      Worker[]
  materials    Material[]
  vendors      Vendor[]
  Notification Notification[]
}

model User {
  id               String     @id @default(uuid())
  email            String     @unique
  passwordHash     String
  firstName        String
  lastName         String
  status           UserStatus @default(ACTIVE)
  resetToken       String?
  resetTokenExpiry DateTime?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  roleId String
  role   Role   @relation(fields: [roleId], references: [id])

  projects   ProjectMember[]
  auditLogs  AuditLog[]
  importJobs ImportJob[]

  // Back relations for new modules
  managedProjects Project[]        @relation("ProjectManager")
  managedSites    Site[]           @relation("SiteManager")
  assignedTasks   Task[]           @relation("TaskAssignee")
  taskComments    TaskComment[]
  taskUploads     TaskAttachment[]

  contractorId String?
  contractor   Contractor? @relation("ContractorUsers", fields: [contractorId], references: [id])

  // Procurement & Finance
  requestedPRs         PurchaseRequest[]     @relation("PRRequester")
  approvedPRs          PurchaseRequest[]     @relation("PRApprover")
  materialReceipts     MaterialReceipt[]     @relation("MaterialReceiver")
  materialConsumptions MaterialConsumption[] @relation("MaterialConsumer")
  preparedDPRs         DailyProgressReport[] @relation("DPRPreparer")
  approvedDPRs         DailyProgressReport[] @relation("DPRApprover")
  reportedIssues       Issue[]               @relation("IssueReporter")
  assignedIssues       Issue[]               @relation("IssueAssignee")
  recordedExpenses     Expense[]             @relation("ExpenseRecorder")

  // Phase 4 Extensions
  issueComments    IssueComment[]
  uploadedPhotos   SitePhoto[]       @relation("PhotoUploader")
  uploadedVersions DocumentVersion[] @relation("DocumentUploader")
  notifications    Notification[]    @relation("UserNotifications")

  // Phase 6 Extensions
  ownedRisks    ProjectRisk[] @relation("RiskOwner")
  reportedRisks ProjectRisk[] @relation("RiskReporter")
  updatedRisks  ProjectRisk[] @relation("RiskUpdater")

  // Phase 5 Finance Extensions
  budgetRevisions    BudgetRevision[]    @relation("BudgetRevisionCreator")
  payments           Payment[]           @relation("PaymentCreator")
  invoiceAttachments InvoiceAttachment[] @relation("InvoiceUploader")
}

model Role {
  id          String @id @default(uuid())
  name        String // SUPER_ADMIN, COMPANY_ADMIN, PROJECT_MANAGER, SITE_ENGINEER, PROCUREMENT_MANAGER, FINANCE_MANAGER, CONTRACTOR, CLIENT, VIEWER
  permissions String // JSON string array of permissions

  organizationId String? // nullable for system-wide roles (like superadmin) or seeded roles, or non-null if custom per org
  organization   Organization? @relation(fields: [organizationId], references: [id])

  users User[]
}

model Project {
  id          String   @id @default(uuid())
  name        String
  description String?
  status      String   @default("PLANNING") // PLANNING, ACTIVE, ON_HOLD, COMPLETED, ARCHIVED
  budget      Float    @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Extensions
  projectCode       String?
  client            String?
  projectType       String?
  location          String?
  startDate         DateTime?
  plannedCompletion DateTime?
  actualCompletion  DateTime?
  contractValue     Float?

  projectManagerId String?
  projectManager   User?   @relation("ProjectManager", fields: [projectManagerId], references: [id])

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  members     ProjectMember[]
  sites       Site[]
  wbsElements WbsElement[]
  tasks       Task[]
  boqItems    BoqItem[]

  // Phase 3 extensions
  contractors          Contractor[]          @relation("ContractorProjects")
  workers              Worker[]
  labourAttendances    LabourAttendance[]
  inventories          ProjectInventory[]
  purchaseRequests     PurchaseRequest[]
  purchaseOrders       PurchaseOrder[]
  materialReceipts     MaterialReceipt[]
  materialConsumptions MaterialConsumption[]
  dailyProgressReports DailyProgressReport[]
  issues               Issue[]
  budgets              Budget[]
  expenses             Expense[]
  invoices             Invoice[]

  // Phase 4 Extensions
  photos        SitePhoto[]
  documents     ProjectDocument[]
  notifications Notification[]

  // Phase 5 Finance
  subcontracts Subcontract[]

  // Phase 6 Extensions
  risks ProjectRisk[]
}

model ProjectMember {
  userId    String
  projectId String
  user      User    @relation(fields: [userId], references: [id])
  project   Project @relation(fields: [projectId], references: [id])

  @@id([userId, projectId])
}

model Site {
  id        String   @id @default(uuid())
  name      String
  location  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  status    String    @default("ACTIVE")
  startDate DateTime?
  notes     String?

  siteManagerId String?
  siteManager   User?   @relation("SiteManager", fields: [siteManagerId], references: [id])

  projectId String
  project   Project @relation(fields: [projectId], references: [id])

  // Phase 3 extensions
  labourAttendances    LabourAttendance[]
  purchaseRequests     PurchaseRequest[]
  materialConsumptions MaterialConsumption[]
  dailyProgressReports DailyProgressReport[]
  issues               Issue[]

  // Phase 4 Extensions
  photos SitePhoto[]
}

model WbsElement {
  id   String @id @default(uuid())
  name String

  projectId String
  project   Project @relation(fields: [projectId], references: [id])

  parentId String?
  parent   WbsElement?  @relation("WbsHierarchy", fields: [parentId], references: [id])
  children WbsElement[] @relation("WbsHierarchy")

  startDate       DateTime?
  endDate         DateTime?
  actualStartDate DateTime?
  actualEndDate   DateTime?
  progress        Float     @default(0)

  responsibleId   String? // String instead of relation to User? Actually relation is better, but maybe just string for simplicity if not always internal. Let's keep it simple string for now, or maybe User? User is better but requirements just say "responsible person". We'll just make it string to allow contractors names without forcing a user.
  responsibleName String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tasks Task[]
}

model Task {
  id          String    @id @default(uuid())
  title       String
  description String?
  priority    String    @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT
  status      String    @default("TODO") // TODO, IN_PROGRESS, BLOCKED, COMPLETED
  dueDate     DateTime?

  projectId String
  project   Project @relation(fields: [projectId], references: [id])

  wbsElementId String?
  wbsElement   WbsElement? @relation(fields: [wbsElementId], references: [id])

  assigneeId String?
  assignee   User?   @relation("TaskAssignee", fields: [assigneeId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  comments     TaskComment[]
  attachments  TaskAttachment[]
  checklist    TaskChecklist[]
  dependencies TaskDependency[] @relation("TaskDependencies")
  dependentOn  TaskDependency[] @relation("TaskDependentOn")
  photos       SitePhoto[]      @relation("TaskPhotos")
}

model TaskDependency {
  id              String @id @default(uuid())
  taskId          String
  task            Task   @relation("TaskDependencies", fields: [taskId], references: [id])
  dependsOnTaskId String
  dependsOnTask   Task   @relation("TaskDependentOn", fields: [dependsOnTaskId], references: [id])
  type            String @default("FINISH_TO_START") // FS, SS, FF, SF
}

model TaskComment {
  id        String   @id @default(uuid())
  text      String
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id])
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  createdAt DateTime @default(now())
}

model TaskAttachment {
  id           String   @id @default(uuid())
  fileName     String
  fileUrl      String
  fileType     String?
  fileSize     Int?
  taskId       String
  task         Task     @relation(fields: [taskId], references: [id])
  uploadedById String
  uploadedBy   User     @relation(fields: [uploadedById], references: [id])
  createdAt    DateTime @default(now())
}

model TaskChecklist {
  id          String  @id @default(uuid())
  title       String
  isCompleted Boolean @default(false)
  taskId      String
  task        Task    @relation(fields: [taskId], references: [id])
}

model BoqItem {
  id              String  @id @default(uuid())
  itemCode        String
  description     String
  category        String?
  unit            String
  quantity        Float
  rate            Float
  estimatedAmount Float
  actualQuantity  Float   @default(0)
  actualAmount    Float   @default(0)

  projectId String
  project   Project @relation(fields: [projectId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(uuid())
  action    String
  entity    String
  entityId  String?
  metadata  String? // JSON string for storing arbitrary metadata about the action
  createdAt DateTime @default(now())

  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
}

// --- Contractor Management ---
model Contractor {
  id            String  @id @default(uuid())
  companyName   String
  contactPerson String
  email         String?
  phone         String?
  status        String  @default("ACTIVE") // ACTIVE, INACTIVE, BLACKLISTED
  contractValue Float   @default(0)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  projects     Project[]     @relation("ContractorProjects")
  workers      Worker[]
  users        User[]        @relation("ContractorUsers")
  subcontracts Subcontract[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// --- Labour Management ---
model Worker {
  id        String @id @default(uuid())
  firstName String
  lastName  String
  category  String // Mason, Carpenter, Electrician, Plumber, Helper, Supervisor, Equipment Operator
  type      String // SKILLED, UNSKILLED, SEMI_SKILLED
  dailyRate Float  @default(0)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  contractorId String?
  contractor   Contractor? @relation(fields: [contractorId], references: [id])

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id])

  attendances LabourAttendance[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model LabourAttendance {
  id            String    @id @default(uuid())
  date          DateTime
  status        String    @default("PRESENT") // PRESENT, ABSENT, HALF_DAY
  checkIn       DateTime?
  checkOut      DateTime?
  overtimeHours Float     @default(0)

  workerId String
  worker   Worker @relation(fields: [workerId], references: [id])

  projectId String
  project   Project @relation(fields: [projectId], references: [id])

  siteId String?
  site   Site?   @relation(fields: [siteId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// --- Material & Vendor Management ---
model Material {
  id       String @id @default(uuid())
  name     String
  code     String
  category String
  unit     String

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  inventories  ProjectInventory[]
  poItems      PurchaseOrderItem[]
  receiptItems MaterialReceiptItem[]
  consumptions MaterialConsumption[]
  requests     PurchaseRequestItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Vendor {
  id            String  @id @default(uuid())
  name          String
  contactPerson String
  email         String?
  phone         String?
  performance   Float   @default(0)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  purchaseOrders PurchaseOrder[]
  expenses       Expense[]
  invoices       Invoice[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProjectInventory {
  id String @id @default(uuid())

  projectId String
  project   Project @relation(fields: [projectId], references: [id])

  materialId String
  material   Material @relation(fields: [materialId], references: [id])

  requiredQuantity Float @default(0)
  receivedQuantity Float @default(0)
  consumedQuantity Float @default(0)
  reorderLevel     Float @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, materialId])
}

// --- Procurement Workflow ---
model PurchaseRequest {
  id       String   @id @default(uuid())
  prNumber String
  date     DateTime @default(now())
  status   String   @default("PENDING") // PENDING, APPROVED, REJECTED

  projectId String
  project   Project @relation(fields: [projectId], references: [id])

  siteId String?
  site   Site?   @relation(fields: [siteId], references: [id])

  requestedById String
  requestedBy   User   @relation("PRRequester", fields: [requestedById], references: [id])

  approvedById String?
  approvedBy   User?   @relation("PRApprover", fields: [approvedById], references: [id])

  items PurchaseRequestItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PurchaseRequestItem {
  id           String    @id @default(uuid())
  quantity     Float
  expectedDate DateTime?

  purchaseRequestId String
  purchaseRequest   PurchaseRequest @relation(fields: [purchaseRequestId], references: [id])

  materialId String
  material   Material @relation(fields: [materialId], references: [id])
}

model PurchaseOrder {
  id               String    @id @default(uuid())
  poNumber         String
  expectedDelivery DateTime?
  status           String    @default("DRAFT") // DRAFT, PENDING_APPROVAL, APPROVED, ORDERED, PARTIALLY_RECEIVED, RECEIVED, CANCELLED

  vendorId String
  vendor   Vendor @relation(fields: [vendorId], references: [id])

  projectId String
  project   Project @relation(fields: [projectId], references: [id])

  items    PurchaseOrderItem[]
  receipts MaterialReceipt[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PurchaseOrderItem {
  id       String @id @default(uuid())
  quantity Float
  rate     Float
  tax      Float  @default(0)
  total    Float

  poId String
  po   PurchaseOrder @relation(fields: [poId], references: [id])

  materialId String
  material   Material @relation(fields: [materialId], references: [id])
}

model MaterialReceipt {
  id            String   @id @default(uuid())
  receiptNumber String
  receivedDate  DateTime @default(now())

  poId String
  po   PurchaseOrder @relation(fields: [poId], references: [id])

  projectId String
  project   Project @relation(fields: [projectId], references: [id])

  receivedById String
  receivedBy   User   @relation("MaterialReceiver", fields: [receivedById], references: [id])

  items MaterialReceiptItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MaterialReceiptItem {
  id       String @id @default(uuid())
  quantity Float

  receiptId String
  receipt   MaterialReceipt @relation(fields: [receiptId], references: [id])

  materialId String
  material   Material @relation(fields: [materialId], references: [id])
}

model MaterialConsumption {
  id       String   @id @default(uuid())
  date     DateTime @default(now())
  quantity Float

  projectId String
  project   Project @relation(fields: [projectId], references: [id])

  siteId String?
  site   Site?   @relation(fields: [siteId], references: [id])

  materialId String
  material   Material @relation(fields: [materialId], references: [id])

  usedById String
  usedBy   User   @relation("MaterialConsumer", fields: [usedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// --- Operations & Finance ---
model DailyProgressReport {
  id            String   @id @default(uuid())
  date          DateTime
  manpowerCount Int      @default(0)
  workCompleted String?
  issues        String?
  nextDayPlan   String?
  status        String   @default("DRAFT") // DRAFT, SUBMITTED, UNDER_REVIEW, APPROVED, REJECTED

  weather            String?
  equipment          Json?
  quantities         Json?
  materialReceived   Json?
  materialConsumed   Json?
  safetyObservations String?
  rejectionReason    String?

  projectId String
  project   Project @relation(fields: [projectId], references: [id])

  siteId String?
  site   Site?   @relation(fields: [siteId], references: [id])

  preparedById String
  preparedBy   User   @relation("DPRPreparer", fields: [preparedById], references: [id])

  approvedById String?
  approvedBy   User?     @relation("DPRApprover", fields: [approvedById], references: [id])
  approvedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  photos SitePhoto[] @relation("DPRPhotos")
}

model Issue {
  id          String    @id @default(uuid())
  title       String
  description String?
  type        String    @default("GENERAL") // DESIGN, MATERIAL, LABOUR, QUALITY, SAFETY, SCHEDULE, EQUIPMENT, OTHER
  priority    String    @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT
  status      String    @default("OPEN") // OPEN, ASSIGNED, IN_PROGRESS, RESOLVED, CLOSED
  location    String?
  dueDate     DateTime?
  resolution  String?

  projectId String
  project   Project @relation(fields: [projectId], references: [id])

  siteId String?
  site   Site?   @relation(fields: [siteId], references: [id])

  reportedById String
  reportedBy   User   @relation("IssueReporter", fields: [reportedById], references: [id])

  assignedToId String?
  assignedTo   User?   @relation("IssueAssignee", fields: [assignedToId], references: [id])

  comments IssueComment[]
  photos   SitePhoto[]    @relation("IssuePhotos")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Budget {
  id             String @id @default(uuid())
  category       String
  originalAmount Float  @default(0)
  currentAmount  Float  @default(0)

  projectId String
  project   Project @relation(fields: [projectId], references: [id])

  revisions BudgetRevision[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BudgetRevision {
  id     String   @id @default(uuid())
  amount Float
  reason String?
  date   DateTime @default(now())
  status String   @default("APPROVED") // PENDING, APPROVED, REJECTED

  budgetId String
  budget   Budget @relation(fields: [budgetId], references: [id])

  createdById String
  createdBy   User   @relation("BudgetRevisionCreator", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Subcontract {
  id             String @id @default(uuid())
  contractValue  Float
  committedValue Float  @default(0)
  billedValue    Float  @default(0)
  paidValue      Float  @default(0)
  retention      Float  @default(0)
  status         String @default("ACTIVE") // ACTIVE, CLOSED, TERMINATED

  contractorId String
  contractor   Contractor @relation(fields: [contractorId], references: [id])

  projectId String
  project   Project @relation(fields: [projectId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Expense {
  id         String   @id @default(uuid())
  title      String
  amount     Float
  date       DateTime @default(now())
  category   String?
  type       String   @default("DIRECT") // DIRECT, REIMBURSABLE, VENDOR
  receiptUrl String?
  status     String   @default("APPROVED") // PENDING_APPROVAL, APPROVED, REJECTED

  vendorId String?
  vendor   Vendor? @relation(fields: [vendorId], references: [id])

  projectId String
  project   Project @relation(fields: [projectId], references: [id])

  recordedById String
  recordedBy   User   @relation("ExpenseRecorder", fields: [recordedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Invoice {
  id            String    @id @default(uuid())
  invoiceNumber String
  date          DateTime  @default(now())
  dueDate       DateTime?
  subtotal      Float
  tax           Float     @default(0)
  total         Float
  amountPaid    Float     @default(0)
  status        String    @default("DRAFT") // DRAFT, SUBMITTED, APPROVED, PARTIALLY_PAID, PAID, REJECTED

  vendorId String
  vendor   Vendor @relation(fields: [vendorId], references: [id])

  projectId String
  project   Project @relation(fields: [projectId], references: [id])

  payments    Payment[]
  attachments InvoiceAttachment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Payment {
  id              String   @id @default(uuid())
  amount          Float
  paymentDate     DateTime @default(now())
  referenceNumber String?
  paymentMethod   String?
  notes           String?

  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id])

  createdById String
  createdBy   User   @relation("PaymentCreator", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model InvoiceAttachment {
  id       String @id @default(uuid())
  fileName String
  fileUrl  String
  fileSize Int
  mimeType String

  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id])

  uploadedById String
  uploadedBy   User   @relation("InvoiceUploader", fields: [uploadedById], references: [id])

  createdAt DateTime @default(now())
}

// --- Phase 4 Advanced Models ---

model IssueComment {
  id   String @id @default(uuid())
  text String

  issueId String
  issue   Issue  @relation(fields: [issueId], references: [id])

  authorId String
  author   User   @relation(fields: [authorId], references: [id])

  createdAt DateTime @default(now())
}

model SitePhoto {
  id          String  @id @default(uuid())
  url         String
  description String?
  location    String?

  uploaderId String
  uploader   User   @relation("PhotoUploader", fields: [uploaderId], references: [id])

  projectId String
  project   Project @relation(fields: [projectId], references: [id])

  siteId String?
  site   Site?   @relation(fields: [siteId], references: [id])

  taskId String?
  task   Task?   @relation("TaskPhotos", fields: [taskId], references: [id])

  issueId String?
  issue   Issue?  @relation("IssuePhotos", fields: [issueId], references: [id])

  dprId String?
  dpr   DailyProgressReport? @relation("DPRPhotos", fields: [dprId], references: [id])

  createdAt DateTime @default(now())
}

model ProjectDocument {
  id       String @id @default(uuid())
  title    String
  category String // Contracts, Drawings, BOQ, Reports, Invoices, Approvals, Safety, Quality, Other
  status   String @default("APPROVED") // DRAFT, SUBMITTED, UNDER_REVIEW, APPROVED, REJECTED

  projectId String
  project   Project @relation(fields: [projectId], references: [id])

  versions DocumentVersion[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DocumentVersion {
  id            String  @id @default(uuid())
  versionNumber Int
  fileUrl       String
  fileName      String
  fileSize      Int
  mimeType      String
  changeDesc    String?
  checksum      String?

  documentId String
  document   ProjectDocument @relation(fields: [documentId], references: [id])

  uploadedById String
  uploadedBy   User   @relation("DocumentUploader", fields: [uploadedById], references: [id])

  createdAt DateTime @default(now())
}

model Notification {
  id         String  @id @default(uuid())
  type       String
  title      String
  message    String
  entityType String?
  entityId   String?
  isRead     Boolean @default(false)

  userId String
  user   User   @relation("UserNotifications", fields: [userId], references: [id])

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id])

  createdAt DateTime @default(now())
}

model ProjectRisk {
  id                   String    @id @default(uuid())
  riskCode             String?
  title                String
  description          String?
  category             String // SCHEDULE, COST, MATERIAL, LABOUR, CONTRACTOR, QUALITY, SAFETY, PROCUREMENT
  severity             String // LOW, MEDIUM, HIGH, CRITICAL
  probability          Float     @default(0) // 1 to 5 scale
  impact               Float     @default(0) // 1 to 5 scale
  riskScore            Float     @default(0) // probability * impact
  status               String    @default("OPEN") // OPEN, MITIGATED, CLOSED
  dueDate              DateTime?
  targetResolutionDate DateTime?
  mitigationPlan       String?
  contingencyPlan      String?
  residualRisk         String?

  projectId String
  project   Project @relation(fields: [projectId], references: [id])

  ownerId String?
  owner   User?   @relation("RiskOwner", fields: [ownerId], references: [id])

  reportedById String
  reportedBy   User   @relation("RiskReporter", fields: [reportedById], references: [id])

  updatedById String?
  updatedBy   User?   @relation("RiskUpdater", fields: [updatedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ImportJob {
  id              String  @id @default(uuid())
  module          String
  filename        String
  fileSize        Int?
  fileType        String?
  sourcePath      String?
  batchId         String?
  status          String  @default("UPLOADED") // UPLOADED, VALIDATING, READY_TO_IMPORT, IMPORTING, COMPLETED, COMPLETED_WITH_WARNINGS, FAILED, CANCELLED
  totalRows       Int     @default(0)
  successfulRows  Int     @default(0)
  warningRows     Int     @default(0)
  failedRows      Int     @default(0)
  duplicateRows   Int     @default(0)
  skippedRows     Int     @default(0)
  createdRows     Int     @default(0)
  updatedRows     Int     @default(0)
  mappingConfig   Json?
  errorReport     Json?
  errorReportPath String?

  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id])

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
}
